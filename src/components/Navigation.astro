---
const navLinks = [
  { href: "#features", label: "Features" },
  { href: "#about", label: "About" },
  { href: "#team", label: "Team" },
  { href: "#contact", label: "Contact" },
];
---

<nav id="menu" class="nav nav--top">
  <div class="nav__container">
    <a class="nav__brand" href="#page-top">
      <img
        src="/img/logo.png"
        alt="Skyward Technologies logo"
        class="nav__brand-mark"
        width="36"
        height="36"
      />
      Skyward<span class="nav__brand-accent">Tech</span>
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="nav__toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div id="nav-links" class="nav__links">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
      <a href="#contact" class="btn btn--primary btn--sm nav__cta">
        Get in Touch
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("menu");
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");

  const syncNavBackground = () => {
    const isTop = window.scrollY < 20;
    const isOpen = links?.classList.contains("is-open");
    nav?.classList.toggle("nav--top", isTop && !isOpen);
    nav?.classList.toggle("nav--scrolled", !(isTop && !isOpen));
  };

  window.addEventListener("scroll", syncNavBackground, { passive: true });
  syncNavBackground();

  toggle?.addEventListener("click", () => {
    const isOpen = links?.classList.toggle("is-open");
    toggle.classList.toggle("is-active", Boolean(isOpen));
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    syncNavBackground();
  });

  links?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      links.classList.remove("is-open");
      toggle?.classList.remove("is-active");
      toggle?.setAttribute("aria-expanded", "false");
      syncNavBackground();
    });
  });
</script>
